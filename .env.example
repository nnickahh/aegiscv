# AI Emergency Coordinator — AWS & OpenCV 5 Configuration
# Set AWS_ENABLE_LIVE=true along with valid IAM credentials to send live calls to AWS cloud.
# When false or omitted, the system uses its automatic Hybrid Cloud Mirror (boto3 + local S3/SQLite replica).

AWS_ENABLE_LIVE=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

AWS_S3_BUCKET=opencv5-ai-emergency-coordinator-evidence
AWS_DYNAMODB_TABLE=EmergencyCoordinatorIncidents
AWS_CLOUDWATCH_NAMESPACE=OpenCV5/EmergencyCoordinator
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:EmergencyResponderDispatch
